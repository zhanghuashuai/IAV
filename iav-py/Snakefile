# ============================================================
# iav-py 主流程
#
# 核心流程（默认 targets）：
#   QC -> consensus -> Nextclade 分型 -> 功能标记 -> 报告
#
# 可选模块（单独指定 target）：
#   results/phylo/HA.treefile
#   results/phylo/HA.timetree.nwk
#   results/phylo/HA.codon.trim.fasta
#   results/selection/HA.selection.tsv
#   results/reassortment/rf_matrix.tsv
#   figures/HA_tree.png
#   results/deseq2/deseq2_results.tsv
#   results/enrich/enrichment.tsv
# ============================================================

configfile: "config/config.yaml"

from pathlib import Path

SAMPLES = list(config["samples"].keys())
SEGMENTS = config["reference"]["segments"]
SEGMENT_PATTERN = "|".join(SEGMENTS)
PHYLO_SEG = config["phylogeny"]["segment"]


def phylo_user_fasta(segment: str) -> str:
    """优先使用配置/约定的用户 FASTA；找不到时返回约定路径（允许不存在）。"""
    configured = config["phylogeny"].get("input_fasta", "")
    if configured:
        path = Path(configured)
        if path.exists():
            stem = path.stem.upper()
            if segment.upper() in stem or not any(
                seg in stem for seg in SEGMENTS
            ):
                return str(path)
    for ext in ("fasta", "fa", "fas", "fna"):
        candidate = Path(f"data/phylo/{segment}.{ext}")
        if candidate.exists():
            return str(candidate)
    return f"data/phylo/{segment}.fasta"


def phylo_dataset_reference(wildcards) -> list[str] | str:
    """需要时自动加入 Nextclade 数据集参考序列（外群）。"""
    if not config["phylogeny"].get("use_nextclade_reference", True):
        return []
    return (
        f"results/nextclade_datasets/{wildcards.segment}/reference.fasta"
    )


def reassortment_tree_inputs() -> list[str]:
    """按 build_trees 配置决定是否在重配前自动建树。"""
    mode = config["reassortment"].get("build_trees", "auto")
    trees = list(config["reassortment"]["trees"].values())
    if mode == "always":
        return trees
    if mode == "never":
        return []
    min_taxa = config["reassortment"].get("min_shared_taxa", 4)
    return trees if len(SAMPLES) >= min_taxa else []


def all_segment_targets() -> list[str]:
    """一次性分析全部节段所需的所有产物。"""
    targets: list[str] = []
    targets += expand("results/consensus/{sample}.fasta", sample=SAMPLES)
    targets += expand("results/nextclade/{sample}.tsv", sample=SAMPLES)
    targets += expand("results/markers/{sample}.tsv", sample=SAMPLES)
    targets += expand("results/phylo/{segment}.treefile", segment=SEGMENTS)
    targets += expand(
        "results/phylo/codon/{segment}.codon.trim.fasta", segment=SEGMENTS
    )
    targets += expand(
        "results/selection/{segment}.selection.tsv", segment=SEGMENTS
    )
    targets += expand("figures/{segment}_tree.png", segment=SEGMENTS)
    targets.append("results/phylo/timetree_status.tsv")
    if Path(config["phylogeny"].get("metadata", "")).is_file():
        targets += expand(
            "results/phylo/{segment}.timetree.nwk", segment=SEGMENTS
        )
    targets.append("results/reassortment/status.tsv")
    return targets


rule all:
    input:
        expand("results/qc/{sample}.json", sample=SAMPLES),
        expand("results/nextclade/{sample}.tsv", sample=SAMPLES),
        expand("results/markers/{sample}.tsv", sample=SAMPLES),
        "reports/report.md",
        "results/reassortment/status.tsv",


rule all_segments:
    input:
        "reports/report_all.md",


rule report_all:
    input:
        all_segment_targets(),
    output:
        "reports/report_all.md",
    params:
        results="results",
        figures="figures",
    shell:
        """
        python scripts/report.py \
          --results {params.results} \
          --figures {params.figures} \
          --out {output}
        """


rule qc:
    input:
        r1=lambda w: config["samples"][w.sample]["r1"],
        r2=lambda w: config["samples"][w.sample]["r2"],
    output:
        r1="results/qc/{sample}_R1.fq.gz",
        r2="results/qc/{sample}_R2.fq.gz",
        report="results/qc/{sample}.json",
    params:
        adapter=config["qc"]["adapter"],
        adapter_r2=config["qc"]["adapter_r2"],
        quality=config["qc"]["quality"],
        min_length=config["qc"]["min_length"],
    threads: 8
    shell:
        """
        python scripts/qc.py \
          --r1 {input.r1} --r2 {input.r2} \
          --out-r1 {output.r1} --out-r2 {output.r2} \
          --report-json {output.report} \
          --adapter '{params.adapter}' \
          --adapter-r2 '{params.adapter_r2}' \
          --quality {params.quality} \
          --min-length {params.min_length} \
          --threads {threads}
        """


rule consensus:
    input:
        r1="results/qc/{sample}_R1.fq.gz",
        r2="results/qc/{sample}_R2.fq.gz",
    output:
        fasta="results/consensus/{sample}.fasta",
        stats="results/consensus/{sample}.stats.tsv",
    params:
        ref=config["reference"]["segments_fasta"],
        assembler=config["assembly"]["assembler"],
        irma_config=config["assembly"]["irma_config"],
        min_depth=config["assembly"]["min_depth"],
        threshold=config["assembly"]["consensus_threshold"],
        workdir="results/irma/{sample}",
        segments=",".join(SEGMENTS),
    threads: config["assembly"]["threads"]
    shell:
        """
        python scripts/consensus.py \
          --sample {wildcards.sample} \
          --r1 {input.r1} --r2 {input.r2} --ref '{params.ref}' \
          --out-fasta {output.fasta} --out-stats {output.stats} \
          --assembler {params.assembler} \
          --irma-config {params.irma_config} \
          --min-depth {params.min_depth} \
          --threshold {params.threshold} \
          --workdir {params.workdir} \
          --segments {params.segments} \
          --threads {threads}
        """


rule typing:
    input:
        consensus="results/consensus/{sample}.fasta",
    output:
        tsv="results/nextclade/{sample}.tsv",
    params:
        dataset_map=",".join(
            f"{k}={v}"
            for k, v in config["typing"]["nextclade_datasets"].items()
        ),
        outdir="results/nextclade/{sample}",
    shell:
        """
        python scripts/nextclade_typing.py \
          --consensus {input.consensus} \
          --out {output.tsv} \
          --dataset-map '{params.dataset_map}' \
          --outdir {params.outdir}
        """


rule markers:
    input:
        nextclade="results/nextclade/{sample}.tsv",
        markers=config["markers"]["file"],
    output:
        tsv="results/markers/{sample}.tsv",
    shell:
        """
        python scripts/markers.py \
          --nextclade {input.nextclade} \
          --markers {input.markers} \
          --out {output.tsv}
        """


rule report:
    input:
        consensus=expand("results/consensus/{sample}.fasta", sample=SAMPLES),
        nextclade=expand("results/nextclade/{sample}.tsv", sample=SAMPLES),
        markers=expand("results/markers/{sample}.tsv", sample=SAMPLES),
        reassortment_status="results/reassortment/status.tsv",
        reassortment_candidates="results/reassortment/candidates.tsv",
    params:
        results="results",
        figures="figures",
    output:
        "reports/report.md",
    shell:
        """
        python scripts/report.py \
          --results {params.results} \
          --figures {params.figures} \
          --out {output}
        """


# ---------------- 可选：系统发育 ----------------

rule phylo_dataset_ref:
    wildcard_constraints:
        segment=SEGMENT_PATTERN,
    output:
        "results/nextclade_datasets/{segment}/reference.fasta",
    params:
        dataset=lambda w: config["typing"]["nextclade_datasets"][w.segment],
    shell:
        """
        nextclade dataset get \
          --name {params.dataset} \
          --output-dir results/nextclade_datasets/{wildcards.segment}
        """


rule phylo_input:
    wildcard_constraints:
        segment=SEGMENT_PATTERN,
    input:
        dataset_ref=phylo_dataset_reference,
        consensus=expand("results/consensus/{sample}.fasta", sample=SAMPLES),
    output:
        "results/phylo/{segment}.input.fasta",
    params:
        user_fasta=lambda w: phylo_user_fasta(w.segment),
        reference_fasta=config["phylogeny"].get("reference_fasta", ""),
        min_sequences=config["phylogeny"].get("min_sequences", 3),
    shell:
        """
        python scripts/phylo_input.py \
          --segment {wildcards.segment} \
          --user-fasta '{params.user_fasta}' \
          --consensus-glob 'results/consensus/*.fasta' \
          --reference-fasta '{params.reference_fasta}' \
          --dataset-reference '{input.dataset_ref}' \
          --min-sequences {params.min_sequences} \
          --out {output}
        """


rule phylo:
    wildcard_constraints:
        segment=SEGMENT_PATTERN,
    input:
        fasta="results/phylo/{segment}.input.fasta",
    output:
        aln="results/phylo/{segment}.aln.fasta",
        trim="results/phylo/{segment}.trim.fasta",
        tree="results/phylo/{segment}.treefile",
    params:
        segment="{segment}",
        mafft_args=config["phylogeny"]["mafft_args"],
        iqtree_args=config["phylogeny"]["iqtree_args"],
    threads: config["phylogeny"]["threads"]
    shell:
        """
        python scripts/phylo.py \
          --fasta {input.fasta} \
          --segment {wildcards.segment} \
          --outdir results/phylo \
          --mafft-args='{params.mafft_args}' \
          --iqtree-args='{params.iqtree_args}' \
          --threads {threads}
        """


rule codon_align:
    wildcard_constraints:
        segment=SEGMENT_PATTERN,
    input:
        fasta="results/phylo/{segment}.input.fasta",
    output:
        aln="results/phylo/codon/{segment}.codon.aln.fasta",
        trim="results/phylo/codon/{segment}.codon.trim.fasta",
    params:
        segment="{segment}",
        mafft_args=config["phylogeny"]["mafft_args"],
    threads: config["phylogeny"]["threads"]
    shell:
        """
        python scripts/phylo.py \
          --fasta {input.fasta} \
          --segment {wildcards.segment} \
          --outdir results/phylo/codon \
          --codon-only \
          --mafft-args='{params.mafft_args}' \
          --threads {threads}
        """


rule timetree_status:
    output:
        "results/phylo/timetree_status.tsv",
    params:
        metadata=config["phylogeny"].get("metadata", ""),
    shell:
        """
        python scripts/timetree_status.py \
          --metadata '{params.metadata}' \
          --out {output}
        """


rule timetree:
    wildcard_constraints:
        segment=SEGMENT_PATTERN,
    input:
        tree="results/phylo/{segment}.treefile",
        aln="results/phylo/{segment}.trim.fasta",
        metadata=config["phylogeny"]["metadata"],
    output:
        tree="results/phylo/{segment}.timetree.nwk",
        clock="results/phylo/{segment}.clock.tsv",
    params:
        prefix="{segment}",
        treetime_args=config["phylogeny"]["treetime_args"],
    shell:
        """
        python scripts/timetree.py \
          --tree {input.tree} \
          --aln {input.aln} \
          --metadata {input.metadata} \
          --outdir results/phylo \
          --prefix {params.prefix} \
          --out-tree {output.tree} \
          --out-clock {output.clock} \
          --treetime-args='{params.treetime_args}'
        """


rule selection:
    wildcard_constraints:
        segment=SEGMENT_PATTERN,
    input:
        aln="results/phylo/codon/{segment}.codon.trim.fasta",
        tree="results/phylo/{segment}.treefile",
    output:
        tsv="results/selection/{segment}.selection.tsv",
    params:
        prefix="{segment}",
    shell:
        """
        python scripts/selection.py \
          --aln {input.aln} \
          --tree {input.tree} \
          --outdir results/selection \
          --prefix {wildcards.segment}
        """


rule reassortment:
    input:
        trees=reassortment_tree_inputs(),
    output:
        matrix="results/reassortment/rf_matrix.tsv",
        candidates="results/reassortment/candidates.tsv",
        status="results/reassortment/status.tsv",
        summary="results/reassortment/taxa_summary.tsv",
    params:
        tree_map=",".join(
            f"{k}={v}"
            for k, v in config["reassortment"]["trees"].items()
        ),
        threshold=config["reassortment"]["distance_threshold"],
        min_shared_taxa=config["reassortment"].get("min_shared_taxa", 4),
    shell:
        """
        python scripts/reassortment.py \
          --tree-map '{params.tree_map}' \
          --outdir results/reassortment \
          --threshold {params.threshold} \
          --min-shared-taxa {params.min_shared_taxa}
        """


rule plot_tree:
    wildcard_constraints:
        segment=SEGMENT_PATTERN,
    input:
        tree="results/phylo/{segment}.treefile",
    output:
        fig="figures/{segment}_tree.png",
    params:
        title=lambda w: f"Influenza A {w.segment}",
    shell:
        """
        python scripts/plot_tree.py \
          --tree {input.tree} \
          --out {output.fig} \
          --title '{params.title}'
        """


rule plots_all:
    input:
        expand("figures/{segment}_tree.png", segment=SEGMENTS),


# ---------------- 可选：宿主转录组 ----------------

rule quant:
    input:
        r1="results/qc/{sample}_R1.fq.gz",
        r2="results/qc/{sample}_R2.fq.gz",
    output:
        quant="results/rnaseq/{sample}/quant.sf",
    params:
        index=config["rnaseq"]["salmon_index"],
        transcriptome=config["rnaseq"]["transcriptome"],
    threads: 8
    shell:
        """
        python scripts/quant.py \
          --r1 {input.r1} --r2 {input.r2} \
          --index {params.index} \
          --transcriptome {params.transcriptome} \
          --outdir results/rnaseq/{wildcards.sample} \
          --threads {threads}
        """


rule deseq2:
    input:
        quant=expand("results/rnaseq/{sample}/quant.sf", sample=SAMPLES),
        metadata=config["rnaseq"]["metadata"],
    output:
        results="results/deseq2/deseq2_results.tsv",
        pca="results/deseq2/pca.png",
        volcano="results/deseq2/volcano.png",
        heatmap="results/deseq2/heatmap.png",
    params:
        design=config["rnaseq"]["design"],
        contrast=config["rnaseq"]["contrast"],
        alpha=config["rnaseq"]["alpha"],
        lfc=config["rnaseq"]["lfc_threshold"],
        tx2gene=config["rnaseq"].get("tx2gene", ""),
    threads: 8
    shell:
        """
        python scripts/deseq2.py \
          --quant-dir results/rnaseq \
          --metadata {input.metadata} \
          --outdir results/deseq2 \
          --design '{params.design}' \
          --contrast '{params.contrast}' \
          --alpha {params.alpha} \
          --lfc {params.lfc} \
          --tx2gene '{params.tx2gene}' \
          --threads {threads}
        """


rule enrich:
    input:
        deseq="results/deseq2/deseq2_results.tsv",
    output:
        "results/enrich/enrichment.tsv",
    params:
        gmt=config["rnaseq"].get("gmt", ""),
        gene_sets=config["rnaseq"].get("gene_sets", "KEGG_2021_Human"),
        id_map=config["rnaseq"].get("id_map", ""),
        padj=config["rnaseq"]["alpha"],
        lfc=config["rnaseq"]["lfc_threshold"],
    shell:
        """
        python scripts/enrich.py \
          --deseq {input.deseq} \
          --outdir results/enrich \
          --gmt '{params.gmt}' \
          --gene-sets '{params.gene_sets}' \
          --id-map '{params.id_map}' \
          --padj {params.padj} \
          --lfc {params.lfc}
        """
